package com.mapfinder.services;

import com.mapfinder.modal.User;

public class UserManager {
	public static boolean addUser(String username,String password) {
		User user=null;
		try {
			 user=new User(username,password);
		}
		catch(Exception e) {
			e.printStackTrace();
			return false;
		}
		return user!=null;
	}
}
