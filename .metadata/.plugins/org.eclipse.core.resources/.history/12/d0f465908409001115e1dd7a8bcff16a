package com.mapfinder.filters;

import java.io.IOException;
import javax.servlet.Filter;
import javax.servlet.FilterChain;
import javax.servlet.FilterConfig;
import javax.servlet.ServletException;
import javax.servlet.ServletRequest;
import javax.servlet.ServletResponse;
import javax.servlet.http.HttpFilter;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import com.mapfinder.utils.SessionUtil;


public class AuthFilter extends HttpFilter implements Filter {

    public AuthFilter() {
        super();
      
    }


	public void destroy() {
	}

	public void doFilter(ServletRequest request, ServletResponse response, FilterChain chain) throws IOException, ServletException {
		 HttpServletRequest req = (HttpServletRequest) request;
	        HttpServletResponse res = (HttpServletResponse) response;

	        // Get the requested URL
	        String requestURI = req.getRequestURI();

	        // Skip the filter for the login page (signin) and other public pages (like register page)
	        if (requestURI.contains("/signin") || requestURI.contains("/signup")) {
	            chain.doFilter(request, response);
	            return;
	        }

	        // Session check for protected URLs
	        System.out.println("checking filter");

	        if (SessionUtil.hasSession(req)) {
	            System.out.println("Session found, proceeding to the requested page.");

	            // Set cache-control headers to prevent browser cache
	            res.setHeader("Cache-Control", "no-cache, no-store, must-revalidate");
	            res.setHeader("Pragma", "no-cache");
	            res.setDateHeader("Expires", 0);

	            // Continue with the request
	            chain.doFilter(request, response);

	        } else {
	            System.out.println("No session found, redirecting to login page.");
	            
	            // Redirect to login page if no session is found
	            res.sendRedirect("/signin"); // You can adjust the path as needed
	        }
		
//		chain.doFilter(request, response);
		
	}


	public void init(FilterConfig fConfig) throws ServletException {

	}

}
