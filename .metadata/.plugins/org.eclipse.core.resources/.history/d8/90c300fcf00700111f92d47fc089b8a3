	public boolean isUserExist(String username, String password) {
		try  {
			PreparedStatement ps=con.prepareStatement(QueryUtil.VIEW_USER);
			ps.setString(1, username);
			ps.setString(2, password);
			return ps.execute();
		} catch (SQLException e) {
			e.printStackTrace();
		}
		return false;
	}

}
