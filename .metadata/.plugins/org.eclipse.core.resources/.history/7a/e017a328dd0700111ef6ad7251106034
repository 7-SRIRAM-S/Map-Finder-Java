import  com.mapfinder.utils.Queries;

public class UserDAOImpl implements UserDAO{

	public static Connection con=DBConnection.getInstance().getConnection();
	
	public boolean insertUser(User user) {
		try  {
			PreparedStatement ps=con.prepareStatement(Queries.insertUser);
			ps.setString(1, user.getUsername());
			ps.setString(2, user.getPassword());
			return ps.executeUpdate()>0;
		} catch (SQLException e) {
			e.printStackTrace();
		}
		return false;
	}

